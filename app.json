{
  "expo": {
    "name": "Purefect Water Station",
    "slug": "water-station-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.purefect.waterstation",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DBEFFB"
      },
      "package": "com.purefect.waterstation",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-notifications",
      "expo-updates",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d471ce02-09f9-4ada-97b6-3f319c427c46"
      }
    },
    "owner": "eomtaehyun",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/d471ce02-09f9-4ada-97b6-3f319c427c46"
    }
  }
}
